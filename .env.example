# ── SENTINEL · runtime configuration ─────────────────────────────────────────
# Copy to .env and change any value that should not ship with the demo.

# HTTP port for the API, WebSocket server and production UI.
PORT=5108

# development | production | test
NODE_ENV=development

# SQLite database. Relative paths resolve from the project root.
DATABASE_PATH=./data/sentinel.db

# Shared secret for ESP32/LoRa gateways. Send it as:
#   X-Gateway-Key: <value>   or   Authorization: Bearer <value>
GATEWAY_KEY=gw-sentinel-demo-key

# Deterministic demo traffic. Set to false when real hardware is connected.
SIMULATION=true
SIMULATION_INTERVAL_MS=4000

# Shown in the command console and written to the audit trail.
OPERATOR_NAME=Duty Officer M. Rao
REGION_NAME=Nashik Basin
EMERGENCY_NUMBER=112

# Telemetry, alerts and incidents older than this are pruned every six hours.
RETENTION_DAYS=30
